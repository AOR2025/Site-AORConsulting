# Copier ce fichier dans .env puis renseigner les valeurs locales.
# Ne jamais versionner .env ni les identifiants réels.
DB_NAME=wordpress
DB_USER=wordpress
DB_PASSWORD=replace-with-a-unique-password
DB_ROOT_PASSWORD=replace-with-another-unique-password
WORDPRESS_BIND=127.0.0.1:8080:80

# Destinataire du formulaire. Vide : adresse administrateur WordPress.
AOR_CONTACT_EMAIL=

# Transport d'envoi : extension WP Mail SMTP, à configurer dans WordPress.
# Voir docs/email.md. Aucun identifiant SMTP à versionner.
